# Copia in .env e compila i valori. Il file .env è in .gitignore.

# Base URL del backend HQ (opzionale, default: https://hq.studiomobilitas.it)
# I video delle landing (Cloudflare Stream) arrivano via API dal gestionale, per codice (es. CERVICALGIA_VSL).
VITE_API_BASE=

# Heatmap interna (docs/heatmap/). Spenta finché non c'è l'ok privacy e il backend in produzione.
VITE_HEATMAP_ENABLED=false
# Quota di sessioni tracciate, da 0 a 1 (default 1 = tutte)
VITE_HEATMAP_SAMPLE=1
# Solo per le prove: traccia anche su localhost (gli eventi vanno al gestionale locale su :8080)
VITE_HEATMAP_LOCALE=false
# Origini in più ammesse per la vista heatmap, separate da virgola (es. il gestionale UAT)
VITE_HEATMAP_VIEWER_ORIGINS=
